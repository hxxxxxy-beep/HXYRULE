{
  "manifest_version": 3,
  "name": "HXYRULE",
  "version": "0.1.85",
  "description": "Personal local video status, playback, and queued downloads for Rule34Video favorites.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HXYRULE",
    "default_popup": "options/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "downloads",
    "cookies",
    "contextMenus",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://rule34video.com/*",
    "https://www.rule34video.com/*",
    "http://127.0.0.1:17934/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://rule34video.com/*",
        "https://www.rule34video.com/*"
      ],
      "js": ["content/native-fav-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://rule34video.com/*",
        "https://www.rule34video.com/*"
      ],
      "js": ["content/favorites.js"],
      "css": ["content/favorites.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
